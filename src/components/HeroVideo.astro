---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { LANDING_VARIANTS, type LandingVariant } from "../config/variants";

interface Props {
  posterURL: string;
  posterImage: ImageMetadata;
  variant?: LandingVariant;
}

const { posterURL, posterImage, variant = "v1" } = Astro.props;
const variantConfig = LANDING_VARIANTS[variant];
const webmasterLine =
  "Zenchef - 63 avenue de Villiers 75017 Paris – webmaster{at}zenchef.com";
const [titleInStart, titleInEnd] = variantConfig.timeline.titleIn;
const [quoteInStart, quoteInEnd] = variantConfig.timeline.quoteIn;
const [fadeOutStart, fadeOutEnd] = variantConfig.timeline.sharedFadeOut;
const menuItemTimings: readonly (readonly [number, number])[] =
  variantConfig.timeline.menuItemIn;
const introCompletion = menuItemTimings[menuItemTimings.length - 1][1];
const defaultMenuItems = [
  { label: "L'univers" },
  { label: "La cuisine" },
  { label: "Offre du moment" },
] as const;
const menuItems =
  "menuItems" in variantConfig ? variantConfig.menuItems : defaultMenuItems;
const isRadial =
  variant === "v6" ||
  variant === "v7" ||
  variant === "v8" ||
  variant === "v9" ||
  variant === "v9a" ||
  variant === "v9b" ||
  variant === "v9c";
const hasEqualRadialLabelSpacing =
  variant === "v7" ||
  variant === "v8" ||
  variant === "v9" ||
  variant === "v9a" ||
  variant === "v9b" ||
  variant === "v9c";
const heroTitle =
  variant === "v7" ||
  variant === "v8" ||
  variant === "v9" ||
  variant === "v9a" ||
  variant === "v9b" ||
  variant === "v9c"
    ? "L'Ouvrière"
    : "L'Ouvriere";
const menuItemStyle = ([start, end]: readonly [number, number]) =>
  `--menu-item-start:${start}ms;--menu-item-duration:${end - start}ms;`;
const windRoseStyle =
  "windRoseIn" in variantConfig
    ? menuItemStyle(variantConfig.windRoseIn)
    : undefined;
const cardinalRotations = [0, 90, 180, 270];
const diagonalRotations = [45, 135, 225, 315];
const referenceIntermediateRotations = [
  22.5, 67.5, 112.5, 157.5, 202.5, 247.5, 292.5, 337.5,
];
const timelineStyle = `--title-in-start:${titleInStart}ms;--title-in-duration:${titleInEnd - titleInStart}ms;--quote-in-start:${quoteInStart}ms;--quote-in-duration:${quoteInEnd - quoteInStart}ms;--fade-out-start:${fadeOutStart}ms;--fade-out-duration:${fadeOutEnd - fadeOutStart}ms;`;
---

<main
  class:list={[
    "landing",
    {
      "nature-version": variant !== "v1",
      "no-blur": variantConfig.backgroundBlurPx === 0,
      "radial-menu": isRadial,
      "equal-radial-label-spacing": hasEqualRadialLabelSpacing,
      "font-eb-garamond": variant === "v9a",
      "font-bodoni-moda": variant === "v9b",
      "font-marcellus": variant === "v9c",
    },
  ]}
  data-demo-root
  data-demo-variant={variant}
  data-video-src={variantConfig.streamMp4Url}
  data-intro-completion={introCompletion}
  style={timelineStyle}
>
  <div class="media" aria-hidden="true">
    <Image
      class="poster"
      src={posterImage}
      alt=""
      loading="eager"
      fetchpriority="high"
      format="webp"
    />
    <video
      data-demo-video
      class="video"
      muted
      loop
      playsinline
      preload="none"
      poster={posterURL}></video>
  </div>
  <div class="scrim" aria-hidden="true"></div>
  <section class="intro" aria-label={heroTitle}>
    <div class="title-lock"><h1>{heroTitle}</h1></div>
    <div class="intro-copy">
      <p class="quote"><em>La pleine mer en pleine terre</em></p><p
        class="attribution"
      >
        G.Pudlowski
      </p>
    </div>
  </section>
  <section
    class="menu"
    data-demo-menu
    tabindex="-1"
    aria-label="Navigation de présentation"
  >
    <ul>
      {
        menuItems.map((item, index) => (
          <li
            class="menu-item"
            data-direction={"direction" in item ? item.direction : undefined}
            style={menuItemStyle(menuItemTimings[index])}
          >
            {variant === "v6" && (
              <svg
                class="menu-arrow"
                viewBox="0 0 80 80"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M16 68C25 30 48 28 62 18" />
                <path d="m52 19 11-2-4 10" />
              </svg>
            )}
            <span>{item.label}</span>
          </li>
        ))
      }
    </ul>
    {
      variant === "v7" && (
        <svg
          class="wind-rose"
          viewBox="0 0 120 120"
          aria-hidden="true"
          focusable="false"
          style={windRoseStyle}
        >
          {cardinalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 60 60)`}>
              <polygon class="wind-rose-face-light" points="60,4 60,60 56,56" />
              <polygon class="wind-rose-face-dark" points="60,4 64,56 60,60" />
            </g>
          ))}
          {diagonalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 60 60)`}>
              <polygon
                class="wind-rose-face-light"
                points="60,22 60,60 57,57"
              />
              <polygon class="wind-rose-face-dark" points="60,22 63,57 60,60" />
            </g>
          ))}
          <circle cx="60" cy="60" r="3" />
        </svg>
      )
    }
    {
      variant === "v8" && (
        <svg
          class="wind-rose reference-compass"
          viewBox="30 30 160 160"
          aria-hidden="true"
          focusable="false"
          style={windRoseStyle}
        >
          {cardinalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 110 110)`}>
              <polygon
                class="reference-compass-face-light"
                points="110,35 110,110 106,104"
              />
              <polygon
                class="reference-compass-face-dark"
                points="110,35 114,104 110,110"
              />
              <path class="reference-compass-spine" d="M110 110 110 35" />
            </g>
          ))}
          {diagonalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 110 110)`}>
              <polygon
                class="reference-compass-face-light"
                points="110,60 110,110 103,104"
              />
              <polygon
                class="reference-compass-face-dark"
                points="110,60 117,104 110,110"
              />
            </g>
          ))}
          {referenceIntermediateRotations.map(rotation => (
            <g transform={`rotate(${rotation} 110 110)`}>
              <polygon
                class="reference-compass-face-light"
                points="110,76 110,110 108,107"
              />
              <polygon
                class="reference-compass-face-dark"
                points="110,76 112,107 110,110"
              />
            </g>
          ))}
          <polygon
            class="reference-compass-hub"
            points="110,104 116,110 110,116 104,110"
          />
        </svg>
      )
    }
    {
      (variant === "v9" ||
        variant === "v9a" ||
        variant === "v9b" ||
        variant === "v9c") && (
        <svg
          class="wind-rose reference-ring-compass"
          viewBox="0 0 120 120"
          aria-hidden="true"
          focusable="false"
          style={windRoseStyle}
        >
          <circle class="reference-ring-compass-ring" cx="60" cy="60" r="31" />
          {cardinalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 60 60)`}>
              <polygon
                class="reference-ring-compass-face-light"
                points="60,6 60,60 57,54"
              />
              <polygon
                class="reference-ring-compass-face-dark"
                points="60,6 63,54 60,60"
              />
            </g>
          ))}
          {diagonalRotations.map(rotation => (
            <g transform={`rotate(${rotation} 60 60)`}>
              <polygon
                class="reference-ring-compass-face-light"
                points="60,36 60,60 57,55"
              />
              <polygon
                class="reference-ring-compass-face-dark"
                points="60,36 63,55 60,60"
              />
            </g>
          ))}
          <polygon
            class="reference-ring-compass-hub"
            points="60,56 64,60 60,64 56,60"
          />
        </svg>
      )
    }
  </section>
  <div class="controls">
    <button type="button" data-intro-skip aria-hidden="true" tabindex="-1"
      >Passer l'introduction</button
    ><button type="button" data-video-toggle aria-hidden="true" tabindex="-1"
      >Lecture / pause de la vidéo</button
    ><a id="mentions-trigger" href="#mentions">Mentions</a>
  </div>
  <aside
    id="mentions"
    class="legal"
    tabindex="-1"
    aria-labelledby="legal-title"
  >
    <a class="legal-close" href="#mentions-trigger">Fermer les mentions</a>
    <h2 id="legal-title">Mentions légales</h2>
    <h3>1/ Editeur du site www.louvriererestaurant.com</h3>
    <p>
      C2J, Sasu, au capital de 1000 euros, immatriculée au RCS de Poitiers sous
      le numéro Poitiers B 901 171 264, Siret n° 94216471600022, ayant son siège
      social au 5 bis place de la Mairie, 86360 Montamisé, numéro de TVA :
      FR05942164716, n° tel : -, email : -
    </p>
    <p>Directeur de la publication : - / -.</p>
    <h3>2/ Hébergeur</h3>
    <p>
      Amazon Web Services EMEA SARL (AWS Europe), 4033 Citywest Avenue, Cooldown
      Commons, County Dublin, IRELAND https://aws.amazon.com
    </p>
    <h3>3/ Webmaster</h3>
    <p>{webmasterLine}</p>
    <p class="media-credit">Visuel : Pexels.</p>
  </aside>
</main>

<script>
  import "../scripts/demo";
</script>

<style>
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("../assets/fonts/CormorantGaramond-Latin-Normal.woff2")
      format("woff2");
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
  }
  @font-face {
    font-family: "EB Garamond";
    src: url("../assets/fonts/eb-garamond/regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "EB Garamond";
    src: url("../assets/fonts/eb-garamond/italic.woff2") format("woff2");
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Bodoni Moda";
    src: url("../assets/fonts/bodoni-moda/regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Bodoni Moda";
    src: url("../assets/fonts/bodoni-moda/italic.woff2") format("woff2");
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Marcellus";
    src: url("../assets/fonts/marcellus/regular.woff2") format("woff2");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    src: url("../assets/fonts/CormorantGaramond-Latin-Italic-400.woff2")
      format("woff2");
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }
  .landing {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #16252c;
    color: #fff;
    font-family: Georgia, "Times New Roman", serif;
    isolation: isolate;
  }
  .media,
  .scrim {
    position: absolute;
    inset: -10px;
  }
  .media {
    overflow: hidden;
    z-index: -2;
  }
  .poster,
  .video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(3px);
    transform: scale(1.025);
  }
  .landing.no-blur .poster,
  .landing.no-blur .video {
    filter: none;
  }
  .nature-version {
    font-family: "Cormorant Garamond", Georgia, serif;
  }
  .font-eb-garamond {
    font-family: "EB Garamond", Georgia, serif;
  }
  .font-bodoni-moda {
    font-family: "Bodoni Moda", Georgia, serif;
  }
  .radial-menu.font-bodoni-moda.is-enhanced .menu ul {
    font-size: clamp(1.35rem, 3vw, 2rem);
  }
  .font-marcellus {
    font-family: "Marcellus", Georgia, serif;
  }
  .font-marcellus .quote {
    font-family: "Cormorant Garamond", Georgia, serif;
  }
  .video {
    position: absolute;
    inset: 0;
  }
  .scrim {
    z-index: -1;
    background: rgba(5, 15, 20, 0.34);
  }
  .intro,
  .menu {
    min-height: 100svh;
    display: grid;
    padding: 2rem;
  }
  .intro {
    position: relative;
  }
  h1 {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    margin: 0;
    transform: translateY(-50%);
    text-align: center;
    font-size: clamp(3.4rem, 11vw, 9rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.9;
  }
  .intro-copy {
    position: absolute;
    top: calc(50% + clamp(2.7rem, 6vw, 5.2rem));
    left: 0;
    width: 100%;
    text-align: center;
  }
  .quote {
    margin: 0 0 0.2rem;
    font-size: clamp(1.1rem, 2vw, 1.65rem);
  }
  .attribution {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.13em;
  }
  .menu {
    position: absolute;
    inset: 0;
    place-items: end start;
    pointer-events: none;
  }
  .menu ul {
    list-style: disc;
    margin: 0 0 8vh 8vw;
    padding-left: 1.2rem;
    font-size: clamp(1.35rem, 3vw, 2.3rem);
    line-height: 1.65;
  }
  .menu li {
    cursor: pointer;
    pointer-events: auto;
  }
  .radial-menu.is-enhanced .menu {
    place-items: center;
    --radial-x: min(30vw, 28rem);
    --radial-y: min(22vh, 15rem);
  }
  .radial-menu.is-enhanced .menu ul {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1.35rem, 3vw, 2.3rem);
    line-height: 1;
  }
  .radial-menu.is-enhanced .menu-item {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    white-space: nowrap;
    transform: none;
  }
  .radial-menu.is-enhanced .menu-item > span {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .radial-menu.is-enhanced .menu-item[data-direction="top"] > span {
    top: calc(-1 * var(--radial-y));
    left: 0;
  }
  .radial-menu.is-enhanced .menu-item[data-direction="bottom"] > span {
    top: var(--radial-y);
    left: 0;
  }
  .radial-menu.is-enhanced .menu-item[data-direction="left"] > span {
    top: 0;
    left: calc(-1 * var(--radial-x));
  }
  .radial-menu.is-enhanced .menu-item[data-direction="right"] > span {
    top: 0;
    left: var(--radial-x);
  }
  .radial-menu .menu-arrow {
    position: absolute;
    width: min(clamp(2.2rem, 4vw, 4rem), calc(var(--radial-y) * 0.4));
    height: min(clamp(2.2rem, 4vw, 4rem), calc(var(--radial-y) * 0.4));
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }
  .radial-menu .menu-arrow path {
    vector-effect: non-scaling-stroke;
  }
  .radial-menu.is-enhanced .menu-item[data-direction="top"] .menu-arrow {
    top: calc(-1 * var(--radial-y) / 3);
    left: 0;
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .radial-menu.is-enhanced .menu-item[data-direction="bottom"] .menu-arrow {
    top: calc(var(--radial-y) / 3);
    left: 0;
    transform: translate(-50%, -50%) rotate(135deg);
  }
  .radial-menu.is-enhanced .menu-item[data-direction="left"] .menu-arrow {
    top: 0;
    left: calc(-1 * var(--radial-x) / 3);
    transform: translate(-50%, -50%) rotate(225deg);
  }
  .radial-menu.is-enhanced .menu-item[data-direction="right"] .menu-arrow {
    top: 0;
    left: calc(var(--radial-x) / 3);
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .radial-menu:not(.is-enhanced) .menu {
    place-items: end start;
  }
  .radial-menu:not(.is-enhanced) .menu ul {
    position: static;
    margin: 0 0 8vh 8vw;
    padding-left: 1.2rem;
    list-style: disc;
    font-size: clamp(1.35rem, 3vw, 2.3rem);
    line-height: 1.65;
  }
  .radial-menu:not(.is-enhanced) .menu-item {
    position: static;
    display: list-item;
    transform: none;
    white-space: normal;
  }
  .radial-menu:not(.is-enhanced) .menu-arrow {
    display: none;
  }
  .wind-rose {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(clamp(11.25rem, 20vw, 17.5rem), calc(var(--radial-y) * 1.8));
    height: min(clamp(11.25rem, 20vw, 17.5rem), calc(var(--radial-y) * 1.8));
    transform: translate(-50%, -50%);
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 0.225;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
  }
  .wind-rose-face-light {
    fill: rgba(255, 255, 255, 0.16);
  }
  .wind-rose-face-dark {
    fill: rgba(255, 255, 255, 0.32);
  }
  .wind-rose polygon,
  .wind-rose path,
  .wind-rose circle {
    vector-effect: non-scaling-stroke;
  }
  .reference-compass {
    stroke: #fffaf0;
    stroke-width: 0.72;
  }
  .reference-compass-face-light {
    fill: rgba(255, 250, 240, 0.12);
  }
  .reference-compass-face-dark {
    fill: rgba(255, 250, 240, 0.28);
  }
  .reference-compass-spine {
    fill: none;
  }
  .reference-compass-hub {
    fill: rgba(255, 250, 240, 0.22);
  }
  .reference-ring-compass {
    stroke: #fffaf0;
    stroke-width: 0.72;
  }
  .reference-ring-compass-ring {
    fill: none;
  }
  .reference-ring-compass-face-light {
    fill: rgba(255, 250, 240, 0.12);
  }
  .reference-ring-compass-face-dark {
    fill: rgba(255, 250, 240, 0.28);
  }
  .reference-ring-compass-hub {
    fill: rgba(255, 250, 240, 0.22);
  }
  .radial-menu.is-enhanced .wind-rose {
    animation: menu-item-in var(--menu-item-duration) var(--menu-item-start)
      ease both;
  }
  .radial-menu:not(.is-enhanced) .wind-rose {
    display: none;
  }
  .controls {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    gap: 0.8rem;
    max-width: calc(100% - 2rem);
    flex-wrap: wrap;
    justify-content: end;
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
  }
  button,
  .controls a {
    color: inherit;
    background: transparent;
    border: 0;
    padding: 0.4rem;
    text-decoration: underline;
    cursor: pointer;
  }
  button:focus-visible,
  .controls a:focus-visible,
  .menu:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .legal {
    position: absolute;
    left: -9999px;
    visibility: hidden;
  }
  .legal:target {
    z-index: 1;
    inset: 1rem;
    left: 1rem;
    margin: 0;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.72);
    font-family: system-ui, sans-serif;
    font-size: 0.75rem;
    line-height: 1.5;
    overflow: auto;
    visibility: visible;
  }
  .legal h2,
  .legal h3,
  .legal p {
    margin: 0 0 1rem;
  }
  .legal h2 {
    font-size: 1.1rem;
  }
  .legal h3 {
    font-size: 0.85rem;
  }
  .legal-close {
    float: right;
    color: inherit;
  }
  [data-demo-root].is-enhanced .poster,
  [data-demo-root].is-enhanced .video {
    filter: blur(0);
    animation: media-blur var(--title-in-duration) var(--title-in-start) ease
      both;
  }
  .landing.no-blur.is-enhanced .poster,
  .landing.no-blur.is-enhanced .video {
    filter: none;
    animation: none;
  }
  [data-demo-root].is-enhanced h1 {
    animation: title-in var(--title-in-duration) var(--title-in-start) ease both;
  }
  [data-demo-root].is-enhanced .title-lock {
    animation: intro-copy var(--fade-out-duration) var(--fade-out-start) ease
      both;
  }
  [data-demo-root].is-enhanced .intro-copy {
    animation: intro-copy var(--fade-out-duration) var(--fade-out-start) ease
      both;
  }
  [data-demo-root].is-enhanced .quote,
  [data-demo-root].is-enhanced .attribution {
    animation: quote-in var(--quote-in-duration) var(--quote-in-start) ease both;
    opacity: 0;
  }
  [data-demo-root].is-enhanced .menu li {
    opacity: 0;
    animation: menu-item-in var(--menu-item-duration) var(--menu-item-start)
      ease both;
  }
  [data-demo-root].is-complete .intro {
    display: none;
  }
  [data-demo-root].is-complete .menu li {
    opacity: 1;
    animation: none;
  }
  [data-demo-root].is-complete .wind-rose {
    opacity: 1;
    animation: none;
  }
  [data-demo-root].is-complete.is-enhanced [data-intro-skip] {
    visibility: hidden;
    pointer-events: none;
  }
  [data-intro-skip] {
    visibility: hidden;
    pointer-events: none;
  }
  [data-video-toggle] {
    min-inline-size: 11rem;
    visibility: hidden;
    pointer-events: none;
  }
  [data-demo-root].has-video [data-video-toggle] {
    visibility: visible;
    pointer-events: auto;
  }
  [data-demo-root].is-enhanced [data-intro-skip] {
    visibility: visible;
    pointer-events: auto;
  }
  @keyframes media-blur {
    to {
      filter: blur(3px);
    }
  }
  @keyframes title-in {
    from {
      opacity: 0;
