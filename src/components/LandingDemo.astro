---
import { getImage } from "astro:assets";
import poster from "../assets/media/calm-sea-waves-poster.jpg";
import type { LandingVariant } from "../config/variants";
import DemoLayout from "../layouts/DemoLayout.astro";
import HeroVideo from "./HeroVideo.astro";

interface Props {
  variant?: LandingVariant;
  root?: boolean;
}

const { variant = "v1", root = false } = Astro.props;
const posterImage = await getImage({ src: poster, format: "webp" });
const title = root ? "L'Ouvriere" : `L'Ouvriere — ${variant}`;
---

<DemoLayout
  title={title}
  description="La pleine mer en pleine terre."
  image={{ src: posterImage.src, width: poster.width, height: poster.height }}
>
  <HeroVideo posterURL={posterImage.src} variant={variant} />
</DemoLayout>
